# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/khuqshdbpmuolyarhuud/settings/api

VITE_SUPABASE_URL=https://khuqshdbpmuolyarhuud.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Keep false in production. Scheduled notifications must be dispatched by the
# backend; true is only for deliberate local scheduler testing.
VITE_ENABLE_CLIENT_NOTIFICATION_SCHEDULER=false

# Server-side Supabase Edge Function secret. Configure with:
# supabase secrets set WHATSHUB_API_KEY=wp_live_...
# Never expose this key as a VITE_ variable.
WHATSHUB_API_KEY=your_whatshub_server_api_key
WHATSHUB_CRON_SECRET=generate_a_long_random_server_secret

# The database scheduler needs matching Supabase Vault secrets named:
# project_url, anon_key, and whatshub_cron_secret.
